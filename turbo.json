{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json", "tsconfig.dts.json", "configs/base.json", "configs/bundler.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "templates/**/*.ts",
        "!templates/**/*.test.ts",
        "$TURBO_ROOT$/configs/sharedTemplates.ts",
        "kubb-extension.json",
        "tsdown.config.ts",
        "package.json",
        "tsconfig.json"
      ]
    },
    "clean": {
      "cache": false
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "cache": false
    },
    "generate": {
      "cache": false
    }
  }
}
