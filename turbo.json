{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.d.ts", "*.d.cts", ".output/**"],
      "inputs": ["src/**/*.ts", "server/**/*.ts", "src/**/*.tsx", "tsdown.config.ts", "nitro.config.ts", "package.json", "tsconfig.json"]
    },
    "clean": {
      "dependsOn": ["^clean"],
      "outputs": [],
      "cache": false,
      "outputLogs": "new-only"
    },
    "start": {
      "dependsOn": ["^start"],
      "outputs": ["dist/**"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json"],
      "outputs": [],
      "cache": false
    },
    "generate": {
      "dependsOn": [],
      "outputs": ["src/gen/**"],
      "inputs": ["kubb.config.ts", "package.json"],
      "cache": false
    }
  }
}
