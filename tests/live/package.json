{
  "name": "tests-live",
  "version": "0.0.0",
  "private": true,
  "description": "Live tests of the generated fetch and axios clients against real APIs",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "https://github.com/kubb-labs/plugins.git",
    "directory": "tests/live"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "generate": "KUBB_DISABLE_TELEMETRY=1 kubb generate --config kubb.config.ts",
    "test": "pnpm run generate && vitest run --config ./vitest.config.ts",
    "typecheck": "pnpm run generate && tsc"
  },
  "dependencies": {
    "@kubb/adapter-oas": "catalog:",
    "@kubb/plugin-axios": "workspace:*",
    "@kubb/plugin-fetch": "workspace:*",
    "@kubb/plugin-ts": "workspace:*",
    "axios": "^1.21.0",
    "kubb": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.22",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
