{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./configs/bundler.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node"],
    "paths": {
      "#mocks": ["./configs/test/mocks.ts"],
      "@internals/ast": ["./internals/ast/src/index.ts"],
      "@internals/shared": ["./internals/shared/src/index.ts"],
      "@internals/shared/types": ["./internals/shared/src/types.ts"],
      "@internals/utils": ["./internals/utils/src/index.ts"],
      "@internals/tanstack-query": ["./internals/tanstack-query/src/index.ts"],
      "@internals/client": ["./internals/client/src/index.ts"],
      "@kubb/plugin-fetch": ["./packages/plugin-fetch/src/index.ts"],
      "@kubb/plugin-axios": ["./packages/plugin-axios/src/index.ts"],
      "@kubb/plugin-ky": ["./packages/plugin-ky/src/index.ts"],
      "@kubb/plugin-client": ["./packages/plugin-client/src/index.ts"],
      "@kubb/plugin-ts": ["./packages/plugin-ts/src/index.ts"],
      "@kubb/plugin-mcp": ["./packages/plugin-mcp/src/index.ts"],
      "@kubb/plugin-msw": ["./packages/plugin-msw/src/index.ts"],
      "@kubb/plugin-react-query": ["./packages/plugin-react-query/src/index.ts"],
      "@kubb/plugin-swr": ["./packages/plugin-swr/src/index.ts"],
      "@kubb/plugin-vue-query": ["./packages/plugin-vue-query/src/index.ts"],
      "@kubb/plugin-redoc": ["./packages/plugin-redoc/src/index.ts"],
      "@kubb/plugin-faker": ["./packages/plugin-faker/src/index.ts"],
      "@kubb/plugin-cypress": ["./packages/plugin-cypress/src/index.ts"],
      "@kubb/plugin-valibot": ["./packages/plugin-valibot/src/index.ts"],
      "@kubb/plugin-zod": ["./packages/plugin-zod/src/index.ts"]
    }
  },
  "include": ["./package.json", "./tsdown.config.ts", "./src/**/*", "tests"],
  "exclude": ["node_modules", "dist", "tmp", "coverage", "**/__snapshots__/**", "packages/*/templates/**", "**/.kubb/**"]
}
