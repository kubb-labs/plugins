{
  "name": "@kubb/plugin-zod",
  "version": "5.7.3",
  "description": "Generate Zod validation schemas with Kubb for runtime data parsing and type safety. Pairs with @kubb/plugin-ts for end-to-end type coverage.",
  "keywords": [
    "code-generation",
    "codegen",
    "kubb",
    "meta-framework",
    "parse",
    "runtime-validation",
    "schema",
    "typescript",
    "validation",
    "zod"
  ],
  "homepage": "https://kubb.dev/extensions/kubb-labs/plugin-zod",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/plugins.git",
    "directory": "packages/plugin-zod"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/stijnvanhulle"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/kubb"
    },
    {
      "type": "custom",
      "url": "https://kubb.dev/sponsors"
    }
  ],
  "files": [
    "templates",
    "dist",
    "kubb-extension.json",
    "docs",
    "!/**/**.test.**",
    "!/**/__tests__/**",
    "!/**/__snapshots__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./kubb-extension.json": "./kubb-extension.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('./dist', {recursive:true,force:true})\"",
    "start": "tsdown --watch",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@internals/shared": "workspace:*",
    "@internals/utils": "workspace:*",
    "kubb": "catalog:",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "kubb": "catalog:",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22"
  }
}
