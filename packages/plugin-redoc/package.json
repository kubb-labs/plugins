{
  "name": "@kubb/plugin-redoc",
  "version": "5.2.0",
  "description": "Generate a ReDoc API reference page with Kubb. Produces a standalone HTML file you can host without a build step.",
  "keywords": [
    "api-docs",
    "api-reference",
    "code-generation",
    "codegen",
    "documentation",
    "kubb",
    "meta-framework",
    "redoc",
    "typescript"
  ],
  "homepage": "https://kubb.dev/extensions/kubb-labs/plugin-redoc",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/plugins.git",
    "directory": "packages/plugin-redoc"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/stijnvanhulle"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/kubb"
    },
    {
      "type": "custom",
      "url": "https://kubb.dev/sponsors"
    }
  ],
  "files": [
    "dist",
    "kubb-extension.json",
    "docs",
    "!/**/**.test.**",
    "!/**/__tests__/**",
    "!/**/__snapshots__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {}
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./kubb-extension.json": "./kubb-extension.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('./dist', {recursive:true,force:true})\"",
    "start": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kubb/kit": "catalog:"
  },
  "devDependencies": {
    "@kubb/adapter-oas": "catalog:"
  },
  "peerDependencies": {
    "@kubb/adapter-oas": "catalog:"
  },
  "engines": {
    "node": ">=22.22"
  }
}
