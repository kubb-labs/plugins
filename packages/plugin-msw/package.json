{
  "name": "@kubb/plugin-msw",
  "version": "6.0.1",
  "description": "Generate Mock Service Worker (MSW) request handlers with Kubb. Intercept HTTP requests in the browser or Node.js for frontend development and testing.",
  "keywords": [
    "api-mocking",
    "code-generation",
    "codegen",
    "kubb",
    "meta-framework",
    "mock-service-worker",
    "mocking",
    "mocks",
    "msw",
    "service-worker",
    "typescript"
  ],
  "homepage": "https://kubb.dev/extensions/kubb-labs/plugin-msw",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/plugins.git",
    "directory": "packages/plugin-msw"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/stijnvanhulle"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/kubb"
    },
    {
      "type": "custom",
      "url": "https://kubb.dev/sponsors"
    }
  ],
  "files": [
    "dist",
    "kubb-extension.json",
    "docs",
    "!/**/**.test.**",
    "!/**/__tests__/**",
    "!/**/__snapshots__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "utils": [
        "./dist/utils.d.ts"
      ],
      "hooks": [
        "./dist/hooks.d.ts"
      ],
      "components": [
        "./dist/components.d.ts"
      ],
      "generators": [
        "./dist/generators.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./kubb-extension.json": "./kubb-extension.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('./dist', {recursive:true,force:true})\"",
    "start": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kubb/plugin-faker": "workspace:^",
    "@kubb/plugin-ts": "workspace:^"
  },
  "devDependencies": {
    "@internals/shared": "workspace:*",
    "@internals/utils": "workspace:*",
    "kubb": "catalog:",
    "msw": "^3.0.3"
  },
  "peerDependencies": {
    "kubb": "catalog:",
    "msw": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22"
  }
}
