{
  "name": "@kubb/plugin-client",
  "version": "5.6.0",
  "description": "Generate typed API operations against your own client module.",
  "keywords": [
    "api-client",
    "code-generation",
    "http-client",
    "kubb",
    "openapi",
    "swagger",
    "typescript"
  ],
  "homepage": "https://kubb.dev/extensions/kubb-labs/plugin-client",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/plugins.git",
    "directory": "packages/plugin-client"
  },
  "files": [
    "src",
    "dist",
    "kubb-extension.json",
    "docs",
    "!/**/**.test.**",
    "!/**/__tests__/**",
    "!/**/__snapshots__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./kubb-extension.json": "./kubb-extension.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('./dist', {recursive:true,force:true})\"",
    "start": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kubb/plugin-ts": "workspace:^",
    "@kubb/plugin-zod": "workspace:^"
  },
  "devDependencies": {
    "@internals/client": "workspace:*",
    "@internals/shared": "workspace:*",
    "kubb": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "kubb": "catalog:"
  },
  "engines": {
    "node": ">=22.22"
  }
}
