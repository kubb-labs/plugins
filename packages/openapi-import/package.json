{
  "name": "openapi-import",
  "version": "0.0.0",
  "description": "Import OpenAPI specs in TypeScript with types from Kubb, through TypeScript 7.1 content mappers. No generated files.",
  "keywords": [
    "code-generation",
    "codegen",
    "content-mapper",
    "kubb",
    "openapi",
    "openapi-import",
    "typescript"
  ],
  "homepage": "https://github.com/kubb-labs/plugins/tree/main/packages/openapi-import#readme",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/plugins.git",
    "directory": "packages/openapi-import"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/stijnvanhulle"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/kubb"
    },
    {
      "type": "custom",
      "url": "https://kubb.dev/sponsors"
    }
  ],
  "files": [
    "dist",
    "!/**/**.test.**",
    "!/**/__tests__/**",
    "!/**/__snapshots__/**"
  ],
  "type": "module",
  "sideEffects": true,
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('./dist', {recursive:true,force:true})\"",
    "start": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kubb/core": "catalog:",
    "@kubb/plugin-ts": "workspace:^",
    "@typescript/typescript6": "catalog:",
    "unplugin-kubb": "catalog:",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@kubb/plugin-zod": "workspace:^",
    "kubb": "catalog:"
  },
  "peerDependencies": {
    "kubb": "catalog:"
  },
  "typescript": {
    "contentMapper": {
      "dynamicConfig": true,
      "exec": [
        "node",
        "dist/server.js"
      ]
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
