{
  "name": "@kubb/plugin-react-query",
  "version": "5.6.2",
  "description": "Generate type-safe TanStack Query (React Query) hooks with Kubb. Covers useQuery, useMutation, useInfiniteQuery, and queryOptions with full TypeScript support.",
  "keywords": [
    "code-generation",
    "codegen",
    "data-fetching",
    "hooks",
    "kubb",
    "meta-framework",
    "react",
    "react-query",
    "tanstack",
    "tanstack-query",
    "typescript",
    "use-mutation",
    "use-query"
  ],
  "homepage": "https://kubb.dev/extensions/kubb-labs/plugin-react-query",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/plugins.git",
    "directory": "packages/plugin-react-query"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/stijnvanhulle"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/kubb"
    },
    {
      "type": "custom",
      "url": "https://kubb.dev/sponsors"
    }
  ],
  "files": [
    "dist",
    "kubb-extension.json",
    "docs",
    "!/**/**.test.**",
    "!/**/__tests__/**",
    "!/**/__snapshots__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "components": [
        "./dist/components.d.ts"
      ],
      "generators": [
        "./dist/generators.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./kubb-extension.json": "./kubb-extension.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('./dist', {recursive:true,force:true})\"",
    "start": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kubb/plugin-ts": "workspace:^"
  },
  "devDependencies": {
    "@internals/client": "workspace:*",
    "@internals/shared": "workspace:*",
    "@internals/tanstack-query": "workspace:*",
    "@internals/utils": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "kubb": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.82.0",
    "kubb": "catalog:"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22"
  }
}
