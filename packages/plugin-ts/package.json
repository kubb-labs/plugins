{
  "name": "@kubb/plugin-ts",
  "version": "5.2.0",
  "description": "Generate TypeScript types, interfaces, and enums with Kubb. The base plugin other Kubb plugins build on for type safety.",
  "keywords": [
    "code-generation",
    "codegen",
    "enums",
    "interfaces",
    "kubb",
    "meta-framework",
    "type-generation",
    "types",
    "typescript"
  ],
  "homepage": "https://kubb.dev/extensions/kubb-labs/plugin-ts",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/plugins.git",
    "directory": "packages/plugin-ts"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/stijnvanhulle"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/kubb"
    },
    {
      "type": "custom",
      "url": "https://kubb.dev/sponsors"
    }
  ],
  "files": [
    "dist",
    "kubb-extension.json",
    "docs",
    "!/**/**.test.**",
    "!/**/__tests__/**",
    "!/**/__snapshots__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./kubb-extension.json": "./kubb-extension.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('./dist', {recursive:true,force:true})\"",
    "start": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kubb/parser-ts": "catalog:",
    "yuku-codegen": "^0.19.0"
  },
  "devDependencies": {
    "@internals/shared": "workspace:*",
    "@internals/utils": "workspace:*",
    "kubb": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "kubb": "^5.14.6",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@typescript/typescript6": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22"
  }
}
