{
  "$schema": "https://kubb.dev/schemas/kubb-extension.json",
  "kind": "plugin",
  "name": "plugin-mcp",
  "export": "pluginMcp",
  "displayName": "MCP",
  "description": "Generates a Model Context Protocol server from your OpenAPI spec, so AI assistants can call each operation as a typed tool.",
  "category": "ai",
  "icon": {
    "light": "https://kubb.dev/feature/mcp-light.svg",
    "dark": "https://kubb.dev/feature/mcp-dark.svg"
  },
  "tags": ["mcp", "model-context-protocol", "ai", "claude", "llm", "codegen", "openapi"],
  "docs": "https://kubb.dev/extensions/kubb-labs/plugin-mcp",
  "maintainers": [
    {
      "name": "Stijn Van Hulle",
      "github": "stijnvanhulle"
    }
  ],
  "dependencies": ["plugin-ts", "plugin-zod"],
  "compatibility": {
    "kubb": ">=5.14.5",
    "node": ">=22.22"
  },
  "role": "consumer",
  "options": [
    {
      "key": "outputPath",
      "path": ["output", "path"],
      "label": "Output Path",
      "description": "Output folder for generated files",
      "type": "text",
      "default": "mcp"
    },
    {
      "key": "barrel",
      "path": ["output", "barrel"],
      "label": "Barrel",
      "description": "How index.ts barrel files are generated",
      "type": "select",
      "default": {
        "type": "named"
      },
      "choices": [
        {
          "label": "named",
          "value": {
            "type": "named"
          }
        },
        {
          "label": "named (nested)",
          "value": {
            "type": "named",
            "nested": true
          }
        },
        {
          "label": "all",
          "value": {
            "type": "all"
          }
        },
        {
          "label": "all (nested)",
          "value": {
            "type": "all",
            "nested": true
          }
        },
        {
          "label": "false (disabled)",
          "value": false
        }
      ]
    },
    {
      "key": "outputMode",
      "path": ["output", "mode"],
      "label": "Output Mode",
      "description": "How the plugin consolidates its code into files. File mode writes everything into a single file, so the output path must include a file extension and cannot be grouped.",
      "type": "select",
      "default": "directory",
      "choices": [
        {
          "label": "directory (one file per schema)",
          "value": "directory"
        },
        {
          "label": "file (single file)",
          "value": "file"
        }
      ]
    },
    {
      "key": "client",
      "path": ["client"],
      "label": "Client",
      "description": "HTTP client the generated handlers call. Only needed to disambiguate when both plugin-fetch and plugin-axios are enabled",
      "type": "select",
      "default": null,
      "choices": [
        {
          "label": "auto-detect",
          "value": null
        },
        {
          "label": "fetch",
          "value": "fetch"
        },
        {
          "label": "axios",
          "value": "axios"
        }
      ]
    },
    {
      "key": "group",
      "path": ["group"],
      "label": "Group",
      "description": "Group generated operations by OpenAPI tag or path",
      "type": "select",
      "default": null,
      "choices": [
        {
          "label": "none",
          "value": null
        },
        {
          "label": "by tag",
          "value": {
            "type": "tag"
          }
        },
        {
          "label": "by path",
          "value": {
            "type": "path"
          }
        }
      ]
    },
    {
      "key": "excludeTags",
      "path": ["exclude"],
      "label": "Exclude Tags",
      "description": "Comma-separated OpenAPI tags to exclude from generation",
      "type": "list",
      "item": {
        "type": "tag",
        "pattern": "$item"
      }
    },
    {
      "key": "includeTags",
      "path": ["include"],
      "label": "Include Tags",
      "description": "Comma-separated OpenAPI tags to include. Only operations with these tags are generated",
      "type": "list",
      "item": {
        "type": "tag",
        "pattern": "$item"
      }
    },
    {
      "key": "banner",
      "path": ["output", "banner"],
      "label": "Banner",
      "description": "Text added at the top of every generated file",
      "type": "text"
    },
    {
      "key": "footer",
      "path": ["output", "footer"],
      "label": "Footer",
      "description": "Text added at the end of every generated file",
      "type": "text"
    }
  ]
}
