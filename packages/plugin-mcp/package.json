{
  "name": "@kubb/plugin-mcp",
  "version": "5.1.1",
  "description": "Generate Model Context Protocol (MCP) tool definitions with Kubb. Expose your REST APIs as AI-callable tools for LLMs, Claude, ChatGPT, and other AI assistants.",
  "keywords": [
    "ai",
    "ai-tools",
    "code-generation",
    "codegen",
    "kubb",
    "llm",
    "mcp",
    "meta-framework",
    "model-context-protocol",
    "typescript"
  ],
  "homepage": "https://kubb.dev/plugins/plugin-mcp",
  "license": "MIT",
  "author": "stijnvanhulle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubb-labs/plugins.git",
    "directory": "packages/plugin-mcp"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/stijnvanhulle"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/kubb"
    },
    {
      "type": "custom",
      "url": "https://kubb.dev/sponsors"
    }
  ],
  "files": [
    "dist",
    "kubb-extension.json",
    "OVERVIEW.md",
    "!/**/**.test.**",
    "!/**/__tests__/**",
    "!/**/__snapshots__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./kubb-extension.json": "./kubb-extension.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('./dist', {recursive:true,force:true})\"",
    "start": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kubb/plugin-ts": "workspace:^",
    "@kubb/plugin-zod": "workspace:^"
  },
  "devDependencies": {
    "@internals/client": "workspace:*",
    "@internals/shared": "workspace:*",
    "@internals/utils": "workspace:*",
    "@modelcontextprotocol/server": "^2.3.1",
    "kubb": "catalog:",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "kubb": "catalog:",
    "zod": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
