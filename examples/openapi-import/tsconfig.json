{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "contentMappers": [
    {
      "package": "openapi-import",
      "extensions": [".openapi.yaml", ".openapi.yml"]
    }
  ],
  "include": ["./src/**/*", "./kubb.config.ts"]
}
